<resources>
<style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
<item name="android:windowBackground">@drawable/launch_background</item>
<item name="android:windowSplashScreenBackground">#F5F8FC</item>
<item name="android:windowSplashScreenAnimatedIcon">@drawable/crock_logo</item>
<item name="android:windowLightStatusBar">true</item>
</style>
<style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
<item name="android:windowBackground">#F5F8FC</item>
<item name="android:windowLightStatusBar">true</item>
</style>
<style name="BrowserWebViewLightTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
<item name="android:isLightTheme">true</item>
</style>
<style name="BrowserWebViewDarkTheme" parent="@android:style/Theme.Material.NoActionBar">
<item name="android:isLightTheme">false</item>
</style>
</resources>
